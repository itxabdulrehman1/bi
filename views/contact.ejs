<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Global Header Navigation Partial -->
  <%- include('partials/nav') %>

  <main>
    <!-- Page Header Banner Partial -->
    <%- include('partials/header', { 
      title: 'Contact Bi-Tech Marketing Solutions', 
      subtitle: 'Reach out to our engineering admissions team, career advisors, or enterprise development leads.' 
    }) %>

    <!-- CONTACT SECTION (Two-Column Asymmetric) -->
    <section class="section">
      <div class="container">
        
        <div class="contact-layout-grid">
          
          <!-- Left Column: Form & Feedback Alert -->
          <div class="contact-form-box">
            <h2 style="font-size: 1.65rem; margin-bottom: 1rem;">Send Us a Message</h2>
            <p style="margin-bottom: 1.5rem; font-size: 0.95rem; color: var(--color-slate);">
              Fill out the form below to inquire about internships, open software roles, or enterprise development solutions.
            </p>

            <!-- Feedback Alert Messages -->
            <% if (typeof successMessage !== 'undefined' && successMessage) { %>
              <div class="alert alert-success" role="alert">
                <strong>Success!</strong> <%= successMessage %>
              </div>
            <% } %>

            <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
              <div class="alert alert-error" role="alert">
                <strong>Error:</strong> <%= errorMessage %>
              </div>
            <% } %>

            <form action="/contact" method="POST" novalidate>
              
              <div class="form-group">
                <label class="form-label" for="name">
                  Full Name <span class="required">*</span>
                </label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  class="form-control" 
                  placeholder="e.g. Muhammad Ali" 
                  value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>" 
                  required
                >
              </div>

              <div class="form-group">
                <label class="form-label" for="email">
                  Email Address <span class="required">*</span>
                </label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  class="form-control" 
                  placeholder="e.g. ali@example.com" 
                  value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>" 
                  required
                >
              </div>

              <div class="form-group">
                <label class="form-label" for="phone">
                  Phone Number <span style="font-weight: 400; color: var(--color-slate);">(Optional)</span>
                </label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  class="form-control" 
                  placeholder="+92 300 0000000" 
                  value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>"
                >
              </div>

              <div class="form-group">
                <label class="form-label" for="subject">
                  Subject / Position of Interest <span style="font-weight: 400; color: var(--color-slate);">(Optional)</span>
                </label>
                <input 
                  type="text" 
                  id="subject" 
                  name="subject" 
                  class="form-control" 
                  placeholder="e.g. Application for Junior Full-Stack Developer" 
                  value="<%= typeof formData !== 'undefined' && formData.subject ? formData.subject : '' %>"
                >
              </div>

              <div class="form-group">
                <label class="form-label" for="message">
                  Message <span class="required">*</span>
                </label>
                <textarea 
                  id="message" 
                  name="message" 
                  class="form-control" 
                  placeholder="Tell us about your background, career goals, or custom development requirements..." 
                  required
                ><%= typeof formData !== 'undefined' && formData.message ? formData.message : '' %></textarea>
              </div>

              <button type="submit" class="btn btn-primary" style="width: 100%; font-size: 1rem; padding: 0.9rem;">Send Message</button>
            
            </form>
          </div>

          <!-- Right Column: Static Contact Info & Map Placeholder -->
          <div>
            <div class="contact-info-card">
              <h2 style="font-size: 1.65rem; margin-bottom: 1.5rem;">Office & Info</h2>
              
              <div class="info-item">
                <div class="info-icon">📍</div>
                <div class="info-text">
                  <strong>Headquarters Address</strong>
                  <span>123 Tech Avenue, Multan, Punjab, Pakistan</span>
                </div>
              </div>

              <div class="info-item">
                <div class="info-icon">📞</div>
                <div class="info-text">
                  <strong>Phone Line</strong>
                  <span>+92 300 1234567</span>
                </div>
              </div>

              <div class="info-item">
                <div class="info-icon">✉️</div>
                <div class="info-text">
                  <strong>Email Inquiries</strong>
                  <span>info@bitechmarketingsolution.online</span>
                </div>
              </div>

              <div class="info-item">
                <div class="info-icon">🕒</div>
                <div class="info-text">
                  <strong>Office Hours</strong>
                  <span>Monday–Friday, 9:00 AM – 6:00 PM PKT</span>
                </div>
              </div>
            </div>

            <!-- Embedded Map Placeholder -->
            <div class="map-container" title="Bi-Tech Marketing Solutions Multan Office Location">
              <iframe 
                src="https://www.openstreetmap.org/export/embed.html?bbox=71.4200%2C30.1500%2C71.5500%2C30.2500&amp;layer=mapnik" 
                loading="lazy" 
                aria-label="Map location of Multan Office"
              ></iframe>
            </div>
          </div>

        </div>

      </div>
    </section>
  </main>

  <!-- Global Footer Partial -->
  <%- include('partials/footer') %>

</body>
</html>
