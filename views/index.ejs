<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Global Header Navigation Partial -->
  <%- include('partials/nav') %>

  <main>
    <!-- HERO SECTION (Asymmetric Two-Column) -->
    <section class="hero-section">
      <div class="container">
        <div class="hero-grid">
          
          <!-- Left Column (55% Width) -->
          <div class="hero-left">
            <h1 class="hero-title">Connecting Computer Science Talent to Enterprise Opportunities</h1>
            <p class="hero-subheadline">
              Bi-Tech Marketing Solutions delivers software engineering careers, immersive technical internships, cybersecurity certification pathways, and real-world business development programs.
            </p>
            <div class="hero-actions">
              <a href="/jobs" class="btn btn-primary">View Open Roles</a>
              <a href="#why-choose-us" class="btn btn-secondary">Explore Programs</a>
            </div>
          </div>

          <!-- Right Column (45% Width): Signature SVG Network Graph -->
          <div class="hero-right">
            <div class="network-graph-container" aria-label="Abstract network graph connecting tech talent to industry opportunities">
              <svg class="network-graph-svg" viewBox="0 0 400 320" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Connecting Line Paths (Animated via stroke-dashoffset on load) -->
                <path class="graph-path" d="M 70 160 Q 130 90 190 75" stroke="#C1FE73" stroke-width="2.5" stroke-linecap="round" />
                <path class="graph-path delay-1" d="M 70 160 Q 130 220 190 235" stroke="#C1FE73" stroke-width="2.5" stroke-linecap="round" opacity="0.8" />
                <path class="graph-path delay-2" d="M 210 70 L 320 105" stroke="#F5F6F3" stroke-width="2" stroke-linecap="round" stroke-dasharray="4 4" opacity="0.6" />
                <path class="graph-path delay-2" d="M 210 240 L 320 115" stroke="#C1FE73" stroke-width="2.5" stroke-linecap="round" />
                <path class="graph-path delay-3" d="M 210 245 L 320 225" stroke="#C1FE73" stroke-width="2.5" stroke-linecap="round" opacity="0.9" />

                <!-- Nodes (Circles & Labels) -->
                <g class="graph-node delay-node-1">
                  <circle cx="60" cy="160" r="18" fill="#000000" stroke="#C1FE73" stroke-width="3" />
                  <circle cx="60" cy="160" r="6" fill="#C1FE73" />
                  <text x="60" y="195" fill="#F5F6F3" font-family="Space Grotesk" font-size="11" font-weight="600" text-anchor="middle">Talent Pool</text>
                </g>

                <g class="graph-node delay-node-2">
                  <circle cx="200" cy="70" r="14" fill="#000000" stroke="#C1FE73" stroke-width="2.5" />
                  <circle cx="200" cy="70" r="4" fill="#C1FE73" />
                  <text x="200" y="48" fill="#F5F6F3" font-family="Space Grotesk" font-size="10" font-weight="500" text-anchor="middle">Internships</text>
                </g>

                <g class="graph-node delay-node-3">
                  <circle cx="200" cy="240" r="14" fill="#000000" stroke="#C1FE73" stroke-width="2.5" />
                  <circle cx="200" cy="240" r="4" fill="#C1FE73" />
                  <text x="200" y="272" fill="#F5F6F3" font-family="Space Grotesk" font-size="10" font-weight="500" text-anchor="middle">Cybersecurity</text>
                </g>

                <g class="graph-node delay-node-4">
                  <circle cx="330" cy="110" r="16" fill="#000000" stroke="#C1FE73" stroke-width="3" />
                  <circle cx="330" cy="110" r="5" fill="#C1FE73" />
                  <text x="330" y="86" fill="#F5F6F3" font-family="Space Grotesk" font-size="10" font-weight="600" text-anchor="middle">CS Roles</text>
                </g>

                <g class="graph-node delay-node-5">
                  <circle cx="330" cy="220" r="14" fill="#000000" stroke="#C1FE73" stroke-width="2.5" />
                  <circle cx="330" cy="220" r="4" fill="#C1FE73" />
                  <text x="330" y="248" fill="#F5F6F3" font-family="Space Grotesk" font-size="10" font-weight="500" text-anchor="middle">Enterprise</text>
                </g>
              </svg>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- SECTION 1: WHY CHOOSE US (Hairline-Border Style, Sharp Corners, No Shadow) -->
    <section id="why-choose-us" class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-heading">Why Choose Us</h2>
          <p>Four pillars that define our technical training, practical mentorship, and placement model.</p>
        </div>

        <div class="grid-features">
          <div class="feature-card">
            <div class="feature-icon">01</div>
            <h3>Real Industry Projects</h3>
            <p>Gain real experience by engineering production software applications deployed for active enterprise clients.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">02</div>
            <h3>Expert Mentorship</h3>
            <p>Learn directly alongside senior developers and cybersecurity architects who review every line of code.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">03</div>
            <h3>Cybersecurity Focus</h3>
            <p>Master practical security testing, ethical hacking, and threat analysis integrated into every track.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">04</div>
            <h3>Career Placement Support</h3>
            <p>Connect directly with our hiring partner network for software development and IT placements.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: ABOUT SNAPSHOT (Left-aligned text + Signature underline text-link) -->
    <section id="about-snapshot" class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-heading">About Bi-Tech</h2>
        </div>
        <div class="about-snapshot-content">
          <p class="about-snapshot-text">
            Bi-Tech Marketing Solutions operates at the intersection of technical talent development and enterprise software delivery. Founded as a modern software house, we combine rigorous engineering mentorship with direct candidate placement across full-stack development, cybersecurity audit, and technical business growth.
          </p>
          <a href="/about" class="text-link">Learn more about our mission and team &rarr;</a>
        </div>
      </div>
    </section>

    <!-- SECTION 3: LATEST OPENINGS PREVIEW (Connected to real JSON data) -->
    <section id="openings" class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-heading">Latest Openings</h2>
          <p>Explore active positions and internship tracks available through our network.</p>
        </div>

        <div class="jobs-grid">
          <% if (typeof featuredJobs !== 'undefined' && featuredJobs.length > 0) { %>
            <% featuredJobs.forEach(job => { %>
              <div class="job-card">
                <div class="job-card-header">
                  <span class="<%= job.type === 'Job' ? 'badge-job' : 'badge-internship' %>"><%= job.type %></span>
                  <span style="font-size: 0.8rem; color: var(--color-slate);"><%= job.location %></span>
                </div>
                <h3><%= job.title %></h3>
                <div class="job-dept"><%= job.department %></div>
                <p><%= job.description %></p>
                <div class="job-card-actions">
                  <a href="/jobs/<%= job.id %>" class="btn btn-secondary" style="width: 100%; text-align: center;">View Details &rarr;</a>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>

        <div style="margin-top: 2rem; text-align: left;">
          <a href="/jobs" class="text-link">View all open positions and internships &rarr;</a>
        </div>
      </div>
    </section>

    <!-- SECTION 3.5: WHAT OUR CLIENTS SAY (Testimonials Section) -->
    <section id="testimonials" class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-heading">What Our Clients Say</h2>
          <p>Feedback from corporate partners, founders, and engineering leads who collaborate with Bi-Tech.</p>
        </div>

        <div class="testimonials-grid">
          <!-- Testimonial 1 -->
          <div class="testimonial-card">
            <div class="testimonial-content">
              <p>"The internship-to-hire pipeline at Bi-Tech supplied us with top-tier junior developers who hit the ground running with production-level Git, API, and full-stack skills."</p>
            </div>
            <div class="testimonial-author">
              <strong>Usman Shah</strong>
              <span>Founder & CTO, Apex Labs</span>
            </div>
          </div>

          <!-- Testimonial 2 -->
          <div class="testimonial-card">
            <div class="testimonial-content">
              <p>"Bi-Tech's agency team delivered our web application redesign and digital strategy ahead of schedule. Their attention to security audits and scalable architecture was outstanding."</p>
            </div>
            <div class="testimonial-author">
              <strong>Sara Malik</strong>
              <span>Head of Operations, Crest Ventures</span>
            </div>
          </div>

          <!-- Testimonial 3 -->
          <div class="testimonial-card">
            <div class="testimonial-content">
              <p>"Finding job-ready cybersecurity talent in the region used to take months. Bi-Tech’s practical lab training ensures candidates have real vulnerability assessment experience."</p>
            </div>
            <div class="testimonial-author">
              <strong>Tariq Mahmood</strong>
              <span>VP of Engineering, CloudScale PK</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: CLOSING CTA SECTION -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-container">
          <h2 class="cta-title">Ready to Accelerate Your Tech Career or Recruit Top Talent?</h2>
          <p class="cta-text">
            Whether you are a developer looking to level up your engineering skills through hands-on internships or an enterprise seeking vetted technical talent, Bi-Tech Marketing Solutions is your partner.
          </p>
          <a href="/contact" class="btn btn-primary">Get In Touch</a>
        </div>
      </div>
    </section>

  </main>

  <!-- Global Footer Partial -->
  <%- include('partials/footer') %>

</body>
</html>
