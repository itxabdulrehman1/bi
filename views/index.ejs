<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Global Header Navigation Partial -->
  <%- include('partials/nav') %>

  <main>
    <!-- HERO SECTION (Asymmetric Two-Column) -->
    <section class="hero-section">
      <div class="container">
        <div class="hero-grid">
          
          <!-- Left Column (55% Width) -->
          <div class="hero-left">
            <h1 class="hero-title">Where Trained Talent Meets Real Client Work</h1>
            <p class="hero-subheadline">
              Bi-Tech Marketing Solutions operates as a hybrid software house and digital marketing agency — combining hands-on developer training with custom web application engineering and data-driven marketing campaigns for growing client brands.
            </p>
            <div class="hero-actions">
              <a href="/services" class="btn btn-primary">Explore Our Services</a>
              <a href="/jobs" class="btn btn-secondary">View Open Positions (2)</a>
            </div>
          </div>

          <!-- Right Column (45% Width): Signature SVG Network Graph -->
          <div class="hero-right">
            <div class="network-graph-container" aria-label="Network graph illustrating talent feeding software development and digital marketing for client brands">
              <svg class="network-graph-svg" viewBox="0 0 400 320" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Connecting Line Paths (Animated via stroke-dashoffset on load) -->
                <path class="graph-path" d="M 70 150 Q 120 100 180 85" stroke="#C1FE73" stroke-width="2.5" stroke-linecap="round" />
                <path class="graph-path delay-1" d="M 70 170 Q 120 220 180 235" stroke="#C1FE73" stroke-width="2.5" stroke-linecap="round" opacity="0.8" />
                <path class="graph-path delay-2" d="M 200 90 Q 250 110 300 150" stroke="#C1FE73" stroke-width="2.5" stroke-linecap="round" />
                <path class="graph-path delay-2" d="M 200 230 Q 250 210 300 170" stroke="#C1FE73" stroke-width="2.5" stroke-linecap="round" opacity="0.8" />
                <path class="graph-path delay-3" d="M 315 150 Q 330 110 345 85" stroke="#C1FE73" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="4 4" />

                <!-- Nodes (Circles & Labels) -->
                <g class="graph-node delay-node-1">
                  <circle cx="60" cy="160" r="18" fill="#000000" stroke="#C1FE73" stroke-width="3" />
                  <circle cx="60" cy="160" r="6" fill="#C1FE73" />
                  <text x="60" y="195" fill="#F5F6F3" font-family="Space Grotesk" font-size="11" font-weight="600" text-anchor="middle">Trained Talent</text>
                </g>

                <g class="graph-node delay-node-2">
                  <circle cx="190" cy="80" r="14" fill="#000000" stroke="#C1FE73" stroke-width="2.5" />
                  <circle cx="190" cy="80" r="4" fill="#C1FE73" />
                  <text x="190" y="56" fill="#F5F6F3" font-family="Space Grotesk" font-size="10" font-weight="500" text-anchor="middle">Software Dev</text>
                </g>

                <g class="graph-node delay-node-3">
                  <circle cx="190" cy="240" r="14" fill="#000000" stroke="#C1FE73" stroke-width="2.5" />
                  <circle cx="190" cy="240" r="4" fill="#C1FE73" />
                  <text x="190" y="270" fill="#F5F6F3" font-family="Space Grotesk" font-size="10" font-weight="500" text-anchor="middle">Digital Marketing</text>
                </g>

                <g class="graph-node delay-node-4">
                  <circle cx="310" cy="160" r="16" fill="#000000" stroke="#C1FE73" stroke-width="3" />
                  <circle cx="310" cy="160" r="5" fill="#C1FE73" />
                  <text x="310" y="195" fill="#F5F6F3" font-family="Space Grotesk" font-size="10" font-weight="600" text-anchor="middle">Client Brands</text>
                </g>

                <g class="graph-node delay-node-5">
                  <circle cx="350" cy="75" r="14" fill="#000000" stroke="#C1FE73" stroke-width="2.5" />
                  <circle cx="350" cy="75" r="4" fill="#C1FE73" />
                  <text x="350" y="52" fill="#F5F6F3" font-family="Space Grotesk" font-size="10" font-weight="500" text-anchor="middle">Delivered Projects</text>
                </g>
              </svg>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- SECTION 1: WHY CHOOSE US -->
    <section id="why-choose-us" class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-heading">Why Choose Us</h2>
          <p>Four pillars defining our dual software engineering, digital marketing, and mentored talent model.</p>
        </div>

        <div class="grid-features">
          <div class="feature-card">
            <div class="feature-icon">01</div>
            <h3>Real Client Projects</h3>
            <p>Gain real experience by building web software and managing live campaigns for client businesses.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">02</div>
            <h3>Expert Mentorship</h3>
            <p>Work directly alongside senior web developers and marketing strategists who guide every deliverable.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">03</div>
            <h3>Integrated Services</h3>
            <p>Combine custom software application development with data-driven social, search, and content campaigns.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">04</div>
            <h3>Practical Growth Track</h3>
            <p>Accelerate practical skills for candidates while delivering measurable return on investment for client brands.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: ABOUT SNAPSHOT -->
    <section id="about-snapshot" class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-heading">About Bi-Tech</h2>
        </div>
        <div class="about-snapshot-content">
          <p class="about-snapshot-text">
            Bi-Tech Marketing Solutions operates at the intersection of technical talent development and client project delivery. Operating as a hybrid software house and digital marketing agency in Chishtian, we combine developer training with production web application development and growth marketing campaigns for expanding businesses.
          </p>
          <a href="/about" class="text-link">Learn more about our mission and team &rarr;</a>
        </div>
      </div>
    </section>

    <!-- SECTION 3: WHAT WE DELIVER -->
    <section id="what-we-deliver" class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-heading">What We Deliver</h2>
          <p>Integrated software engineering and digital marketing solutions powered by mentored talent and experienced leads.</p>
        </div>

        <div class="deliver-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem;">
          
          <!-- Card 1: Software We Build -->
          <div class="service-card" style="border-left: 4px solid var(--color-signal);">
            <div class="service-card-header">
              <h3 style="font-size: 1.4rem; margin-bottom: 0.75rem;">Software We Build</h3>
              <p class="service-description" style="font-size: 0.98rem; line-height: 1.6; margin-bottom: 1.25rem;">
                We design, engineer, and maintain custom web applications for client businesses and growing brands. Our developer candidates work under direct senior mentorship to craft responsive layouts, clean server-side APIs, and database solutions.
              </p>
            </div>
            <div class="service-checklist-title">Core Deliverables</div>
            <ul class="service-checklist">
              <li>Custom business web apps & portals</li>
              <li>E-commerce platforms & CMS builds</li>
              <li>Internal tools, APIs & admin dashboards</li>
            </ul>
          </div>

          <!-- Card 2: Campaigns We Run -->
          <div class="service-card" style="border-left: 4px solid var(--color-signal);">
            <div class="service-card-header">
              <h3 style="font-size: 1.4rem; margin-bottom: 0.75rem;">Campaigns We Run</h3>
              <p class="service-description" style="font-size: 0.98rem; line-height: 1.6; margin-bottom: 1.25rem;">
                Our digital agency team executes multi-channel growth strategies that expand brand visibility and capture qualified sales leads. We combine creative brand identity design, targeted paid advertising, and performance copywriting to drive measurable results.
              </p>
            </div>
            <div class="service-checklist-title">Core Deliverables</div>
            <ul class="service-checklist">
              <li>Social media & content marketing</li>
              <li>Paid advertising (Google Ads & Meta PPC)</li>
              <li>Brand identity design & email marketing</li>
            </ul>
          </div>

        </div>

        <div style="margin-top: 2.5rem; text-align: left;">
          <a href="/services" class="btn btn-primary">Explore Our Agency & Technical Services &rarr;</a>
        </div>
      </div>
    </section>

    <!-- SECTION 3.5: WHAT OUR CLIENTS SAY -->
    <section id="testimonials" class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-heading">What Our Clients Say</h2>
          <p>Feedback from corporate partners, founders, and business leads who collaborate with Bi-Tech.</p>
        </div>

        <div class="testimonials-grid">
          <!-- Testimonial 1 -->
          <div class="testimonial-card">
            <div class="testimonial-content">
              <p>"Bi-Tech's team developed our custom business portal and integrated client management workflow. Their junior developers under senior supervision delivered excellent quality."</p>
            </div>
            <div class="testimonial-author">
              <strong>Usman Shah</strong>
              <span>Founder, Apex Solutions</span>
            </div>
          </div>

          <!-- Testimonial 2 -->
          <div class="testimonial-card">
            <div class="testimonial-content">
              <p>"Bi-Tech's digital marketing team redesigned our brand identity and managed our social media campaigns, resulting in steady lead growth and improved customer reach."</p>
            </div>
            <div class="testimonial-author">
              <strong>Sara Malik</strong>
              <span>Head of Operations, Crest Ventures</span>
            </div>
          </div>

          <!-- Testimonial 3 -->
          <div class="testimonial-card">
            <div class="testimonial-content">
              <p>"Working with Bi-Tech gave us dedicated digital marketing and web maintenance support without the overhead of building an in-house team from scratch."</p>
            </div>
            <div class="testimonial-author">
              <strong>Tariq Mahmood</strong>
              <span>Director, CloudScale PK</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: CLOSING CTA SECTION -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-container">
          <h2 class="cta-title">Ready to Grow Your Brand or Launch Your Tech Career?</h2>
          <p class="cta-text">
            Whether you need custom web application development, a digital marketing strategy, or hands-on internship experience in Chishtian, Bi-Tech Marketing Solutions is ready to collaborate.
          </p>
          <a href="/contact" class="btn btn-primary">Get In Touch</a>
        </div>
      </div>
    </section>

  </main>

  <!-- Global Footer Partial -->
  <%- include('partials/footer') %>

</body>
</html>
