<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Global Header Navigation Partial -->
  <%- include('partials/nav') %>

  <main>
    <!-- Page Header Banner Partial -->
    <%- include('partials/header', { 
      title: 'Our Services & Training Programs', 
      subtitle: 'Specialized engineering tracks, cybersecurity labs, and custom software development solutions.' 
    }) %>

    <!-- SERVICE OFFERINGS SECTION -->
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-heading">Core Technical Programs</h2>
          <p>Explore our specialized software training, security internships, and business operations tracks.</p>
        </div>

        <div class="services-detailed-grid">
          
          <!-- Service 1: Software Development Training -->
          <div class="service-card">
            <div class="service-card-header">
              <h3>Software Development Training</h3>
              <p class="service-description">Full-stack web and mobile application engineering training designed for computer science students and junior developers.</p>
            </div>
            <div class="service-checklist-title">Program Includes</div>
            <ul class="service-checklist">
              <li>Real client-style production projects</li>
              <li>One-on-one code reviews & engineering mentorship</li>
              <li>MERN stack (MongoDB, Express, React, Node.js) & SQL focus</li>
              <li>REST API design & version control workflows</li>
            </ul>
          </div>

          <!-- Service 2: Cybersecurity Internship Program (Teal Circuit Accent) -->
          <div class="service-card circuit-accent">
            <div class="service-card-header">
              <h3>Cybersecurity Internship Program</h3>
              <p class="service-description">Practical hands-on internship track covering network security, ethical hacking fundamentals, and secure coding practices.</p>
            </div>
            <div class="service-checklist-title">Program Includes</div>
            <ul class="service-checklist">
              <li>Vulnerability assessment & penetration testing labs</li>
              <li>Security auditing & OWASP Top 10 compliance exercises</li>
              <li>Industry best practices & secure architecture design</li>
              <li>Certification preparation guidance (Security+, CEH)</li>
            </ul>
          </div>

          <!-- Service 3: Business & Marketing Operations Training -->
          <div class="service-card">
            <div class="service-card-header">
              <h3>Business & Marketing Operations Training</h3>
              <p class="service-description">Practical training bridging software solutions with digital marketing, client management, and tech business operations.</p>
            </div>
            <div class="service-checklist-title">Program Includes</div>
            <ul class="service-checklist">
              <li>Live digital marketing campaign work & strategy</li>
              <li>Enterprise CRM exposure & workflow integration</li>
              <li>Client-facing communication & project scoping</li>
              <li>Business strategy fundamentals & startup scaling</li>
            </ul>
          </div>

          <!-- Service 4: Custom Software Development Services -->
          <div class="service-card">
            <div class="service-card-header">
              <h3>Custom Software Development Services</h3>
              <p class="service-description">Dedicated software development services for corporate clients and SMEs, built by supervised interns and senior engineers.</p>
            </div>
            <div class="service-checklist-title">Services Include</div>
            <ul class="service-checklist">
              <li>Responsive website & web portal development</li>
              <li>Internal business tools & workflow automation apps</li>
              <li>Database-driven web applications & API integrations</li>
              <li>Ongoing application maintenance, hosting & security monitoring</li>
            </ul>
          </div>

        </div>
      </div>
    </section>

    <!-- SECTION 2: AGENCY SERVICES -->
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-heading">Agency Services</h2>
          <p>Full-spectrum digital marketing, custom engineering, design, and administrative services for growing businesses.</p>
        </div>

        <div class="services-detailed-grid">
          <!-- Agency Service 1: Website Development -->
          <div class="service-card">
            <div class="service-card-header">
              <h3>Website Development</h3>
              <p class="service-description">Custom responsive websites, portals, and web applications built for speed, conversion, and scalability.</p>
            </div>
            <div class="service-checklist-title">Key Capabilities</div>
            <ul class="service-checklist">
              <li>Full-stack Web & Mobile Applications</li>
              <li>E-Commerce & CMS Implementations</li>
              <li>API Integration & Performance Tuning</li>
            </ul>
          </div>

          <!-- Agency Service 2: Social Media Marketing -->
          <div class="service-card">
            <div class="service-card-header">
              <h3>Social Media Marketing</h3>
              <p class="service-description">Multi-platform social management, audience engagement campaigns, and targeted content creation.</p>
            </div>
            <div class="service-checklist-title">Key Capabilities</div>
            <ul class="service-checklist">
              <li>Content Calendar & Strategy Design</li>
              <li>Community Management & Engagement</li>
              <li>Brand Presence Across Major Channels</li>
            </ul>
          </div>

          <!-- Agency Service 3: Digital Marketing Strategy -->
          <div class="service-card">
            <div class="service-card-header">
              <h3>Digital Marketing Strategy</h3>
              <p class="service-description">Data-backed growth strategies tailored to expand brand reach and generate qualified customer leads.</p>
            </div>
            <div class="service-checklist-title">Key Capabilities</div>
            <ul class="service-checklist">
              <li>Competitor & Market Research</li>
              <li>Funnel Optimization & Analytics</li>
              <li>Multi-Channel Growth Roadmaps</li>
            </ul>
          </div>

          <!-- Agency Service 4: Graphic Design & Branding -->
          <div class="service-card">
            <div class="service-card-header">
              <h3>Graphic Design & Branding</h3>
              <p class="service-description">Distinct brand identities, logos, visual systems, and marketing collateral designed to leave a mark.</p>
            </div>
            <div class="service-checklist-title">Key Capabilities</div>
            <ul class="service-checklist">
              <li>Logo & Brand Identity Kits</li>
              <li>UI/UX Component & Layout Design</li>
              <li>Marketing Assets & Visual Collateral</li>
            </ul>
          </div>

          <!-- Agency Service 5: Paid Advertising (PPC) -->
          <div class="service-card">
            <div class="service-card-header">
              <h3>Paid Advertising (PPC)</h3>
              <p class="service-description">Targeted Google Ads, Meta Ads, and LinkedIn campaigns optimized for high ROI and immediate traction.</p>
            </div>
            <div class="service-checklist-title">Key Capabilities</div>
            <ul class="service-checklist">
              <li>Keyword Bidding & Audience Targeting</li>
              <li>Ad Copywriting & A/B Creative Testing</li>
              <li>Conversion Tracking & ROI Analytics</li>
            </ul>
          </div>

          <!-- Agency Service 6: Content Marketing -->
          <div class="service-card">
            <div class="service-card-header">
              <h3>Content Marketing</h3>
              <p class="service-description">High-value copy, technical articles, and storytelling that position your brand as an industry leader.</p>
            </div>
            <div class="service-checklist-title">Key Capabilities</div>
            <ul class="service-checklist">
              <li>SEO Copywriting & Blog Publications</li>
              <li>Whitepapers & Case Studies</li>
              <li>Lead Magnet & Ebook Production</li>
            </ul>
          </div>

          <!-- Agency Service 7: Email Marketing -->
          <div class="service-card">
            <div class="service-card-header">
              <h3>Email Marketing</h3>
              <p class="service-description">Automated email sequences, newsletter design, and lifecycle retention campaigns that convert subscribers.</p>
            </div>
            <div class="service-checklist-title">Key Capabilities</div>
            <ul class="service-checklist">
              <li>Automated Drip & Onboarding Sequences</li>
              <li>Newsletter Layouts & Copywriter Review</li>
              <li>Subscriber Segmentation & Re-engagement</li>
            </ul>
          </div>

          <!-- Agency Service 8: Virtual Assistant Services -->
          <div class="service-card">
            <div class="service-card-header">
              <h3>Virtual Assistant Services</h3>
              <p class="service-description">Dedicated administrative support, scheduling, inbox management, and operational assistance.</p>
            </div>
            <div class="service-checklist-title">Key Capabilities</div>
            <ul class="service-checklist">
              <li>Executive Calendar & Email Management</li>
              <li>Data Entry & Operations Support</li>
              <li>Client Correspondence & Scheduling</li>
            </ul>
          </div>

          <!-- Agency Service 9: Bookkeeping -->
          <div class="service-card">
            <div class="service-card-header">
              <h3>Bookkeeping</h3>
              <p class="service-description">Accurate financial record management, invoicing, expense categorization, and monthly reports.</p>
            </div>
            <div class="service-checklist-title">Key Capabilities</div>
            <ul class="service-checklist">
              <li>Invoicing & Accounts Payable/Receivable</li>
              <li>Monthly Expense Categorization</li>
              <li>Financial Reconciliation & Reporting</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: HOW WE WORK (4-Step Process) -->
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-heading">How We Work</h2>
          <p>Our structured 4-step framework for delivering client solutions and training success.</p>
        </div>

        <div class="grid-features">
          <div class="feature-card">
            <div class="feature-icon">01</div>
            <h3>Book a Call</h3>
            <p>Discuss goals and challenges to align strategies and define key technical outcomes.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">02</div>
            <h3>Customized Plan</h3>
            <p>Built around your specific needs and objectives with clear timelines and milestones.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">03</div>
            <h3>Proposal & Strategy</h3>
            <p>Tailored to your business goals with comprehensive scopes, deliverables, and metrics.</p>
          </div>

          <div class="feature-card">
            <div class="feature-icon">04</div>
            <h3>Expert Execution</h3>
            <p>SEO, PPC, social media, and content creation executed by specialized engineering and marketing leads.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CLOSING CTA SECTION -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-container">
          <h2 class="cta-title">Not Sure Which Program Fits You?</h2>
          <p class="cta-text">
            Contact our team for guidance tailored to your career goals or custom business development requirements.
          </p>
          <a href="/contact" class="btn btn-primary">Contact Our Team</a>
        </div>
      </div>
    </section>

  </main>

  <!-- Global Footer Partial -->
  <%- include('partials/footer') %>

</body>
</html>
